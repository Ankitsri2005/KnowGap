# Server
PORT=3000
NODE_ENV=development

# MongoDB (Atlas or local)
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/knowgap?retryWrites=true&w=majority
# If you see "querySrv ECONNREFUSED", use the non-SRV string from Atlas instead:
# MONGO_URI=mongodb://USER:PASSWORD@cluster.mongodb.net/knowgap?retryWrites=true&w=majority&tls=true

# Auth — use a long random string in production (openssl rand -base64 32)
JWT_SECRET=your-secret-key

# Optional: comma-separated origins for cross-origin API access (e.g. https://app.example.com)
# ALLOWED_ORIGINS=

# Set to false to disable auto-seeding subjects when the database is empty (default: seeds on startup)
# AUTO_SEED=true
